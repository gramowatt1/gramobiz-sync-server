# Copy to .env for local development. A hosted deploy (Render, Railway, your own server)
# injects these as real environment variables instead — this file is never read there.

# Postgres connection string. A Render/Railway Postgres add-on provides this automatically when
# attached to this service.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gramobiz_sync

# Port this server listens on. Most hosts (Render, Railway) set PORT themselves in production.
PORT=4100

# The one secret you set yourself — proves you're the owner of this deployment when registering
# a new till against it (POST /v1/stores/register, header x-setup-key). Pick anything long and
# random; there's no dashboard or account recovery here, so write it down somewhere safe.
# Generate one with, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETUP_KEY=

# Only used by docker-compose.yml (ignored if you're running `npm start` directly against your
# own Postgres) — sets the password for the Postgres container it starts alongside this server.
POSTGRES_PASSWORD=postgres
